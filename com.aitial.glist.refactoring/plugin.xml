<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>

   <extension
         point="org.eclipse.ui.commands">
      <command
            id="com.aitial.glist.commands.renameProject"
            name="Rename GlistApp Project...">
      </command>
   </extension>

   <extension
         point="org.eclipse.ui.handlers">
      <handler
            class="com.aitial.glist.handlers.RenameProjectHandler"
            commandId="com.aitial.glist.commands.renameProject">
         <activeWhen>
            <with variable="selection">
               <iterate operator="or">
                  <adapt type="org.eclipse.core.resources.IProject">
                     <and>
                        <test property="org.eclipse.core.resources.open" value="true"/>
                        
                        <test property="org.eclipse.core.resources.projectNature" value="org.eclipse.cdt.core.cnature"/>
                        
                        <not>
                           <test property="org.eclipse.core.resources.name" value="GlistEngine"/>
                        </not>
                        
                        <not>
                           <test property="org.eclipse.core.resources.name" value="glistengine"/>
                        </not>
                     </and>
                  </adapt>
               </iterate>
            </with>
         </activeWhen>
      </handler>
   </extension>

   <extension
         point="org.eclipse.ui.menus">
      
      <menuContribution
            allPopups="false"
            locationURI="menu:file?after=rename">
         <command
               commandId="com.aitial.glist.commands.renameProject"
               label="Rename GlistApp Project..."
               style="push">
         </command>
      </menuContribution>
      
      <menuContribution
            allPopups="false"
            locationURI="popup:org.eclipse.ui.popup.any">
         <command
               commandId="com.aitial.glist.commands.renameProject"
               label="Rename GlistApp Project..."
               style="push">
         </command>
      </menuContribution>
      
   </extension>

</plugin>